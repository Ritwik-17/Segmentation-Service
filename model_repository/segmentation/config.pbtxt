name: "segmentation"
platform: "onnxruntime_onnx"
max_batch_size: 2
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [1, 96, 96, 96]
  }
]
output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [133, 96, 96, 96]
  }
]
instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]